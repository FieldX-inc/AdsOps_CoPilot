# Cloud Run API production service env.
# Store real values in Secret Manager or Cloud Run service env, not in git.
# This template intentionally contains placeholders. Run scripts/check-env.mjs against the real production env after replacing them.
APP_ENV=production
DEPLOY_SURFACE=api
WEB_ORIGIN=https://app.example.com
API_PUBLIC_ORIGIN=https://api.example.com

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=replace-with-production-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-secret
SUPABASE_AUTH_SITE_URL=https://app.example.com
SUPABASE_AUTH_REDIRECT_URLS=https://app.example.com/auth/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=replace-with-production-login-client-id
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=replace-with-production-login-client-secret

TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-secret
TOKEN_ENCRYPTION_KEY_ID=production-v1

GOOGLE_ADS_CLIENT_ID=replace-with-production-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=replace-with-production-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-production-google-ads-developer-token
GOOGLE_ADS_REDIRECT_URI=https://api.example.com/oauth/google/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_STATE_STORE=db
GOOGLE_ADS_WRITE_ENABLED=true
GOOGLE_ADS_MAX_BUDGET_AMOUNT=50000
GOOGLE_ADS_STAGING_E2E_PASSED_AT=replace-with-google-ads-staging-e2e-iso-timestamp

STRIPE_SECRET_KEY=replace-with-production-stripe-secret-key
STRIPE_PRICE_ID=replace-with-production-stripe-price-id
STRIPE_WEBHOOK_SECRET=replace-with-production-stripe-webhook-secret
STRIPE_STAGING_E2E_PASSED_AT=replace-with-stripe-staging-e2e-iso-timestamp

AGENT_SERVICE_URL=https://agent.example.com
AGENT_SERVICE_AUTH_MODE=google_id_token
AGENT_SERVICE_AUDIENCE=https://agent.example.com
USE_AGENT_SERVICE=true
AGENT_SERVICE_TIMEOUT_MS=35000
OPENAI_AGENT_STAGING_E2E_PASSED_AT=replace-with-openai-agent-staging-e2e-iso-timestamp
DEPLOYMENT_RUNBOOK_ACK=true
