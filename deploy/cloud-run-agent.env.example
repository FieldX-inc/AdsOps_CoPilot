# Cloud Run OpenAI Agent Service env.
# Store real values in Secret Manager or Cloud Run service env, not in git.
APP_ENV=staging
DEPLOY_SURFACE=agent
ADOPS_AGENT_RUNTIME=openai
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_AGENTS_MODEL=gpt-5.2
OPENAI_AGENTS_TIMEOUT_SECONDS=45
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
ADOPS_DATABASE_URL=
