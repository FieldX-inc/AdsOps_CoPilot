# Cloud Run API service env.
# Store real values in Secret Manager or Cloud Run service env, not in git.
APP_ENV=staging
DEPLOY_SURFACE=api
WEB_ORIGIN=https://web.staging.example.com
API_PUBLIC_ORIGIN=https://api.staging.example.com

SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
SUPABASE_AUTH_SITE_URL=https://web.staging.example.com
SUPABASE_AUTH_REDIRECT_URLS=https://web.staging.example.com/auth/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=replace-with-login-client-id
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=replace-with-login-client-secret

TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-secret
TOKEN_ENCRYPTION_KEY_ID=staging-v1

GOOGLE_ADS_CLIENT_ID=replace-with-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=replace-with-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-google-ads-developer-token
GOOGLE_ADS_REDIRECT_URI=https://api.staging.example.com/oauth/google/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_STATE_STORE=db
GOOGLE_ADS_WRITE_ENABLED=false
GOOGLE_ADS_MAX_BUDGET_AMOUNT=50000
GOOGLE_ADS_STAGING_E2E_PASSED_AT=

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PRICE_ID=replace-with-stripe-price-id
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_STAGING_E2E_PASSED_AT=

AGENT_SERVICE_URL=https://agent.staging.example.com
AGENT_SERVICE_AUTH_MODE=google_id_token
AGENT_SERVICE_AUDIENCE=https://agent.staging.example.com
USE_AGENT_SERVICE=true
AGENT_SERVICE_TIMEOUT_MS=35000
OPENAI_AGENT_STAGING_E2E_PASSED_AT=
DEPLOYMENT_RUNBOOK_ACK=false
