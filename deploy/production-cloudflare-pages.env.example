# Cloudflare Pages production browser-safe env only.
# Never add service role keys, OAuth secrets, OpenAI keys, Stripe secrets, Google Ads developer tokens, DB URLs, or service tokens here.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-production-anon-public-key
VITE_AUTH_REDIRECT_PATH=/auth/callback
