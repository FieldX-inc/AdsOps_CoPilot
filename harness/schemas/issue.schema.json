{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldx.example/schemas/adops-issue-manifest-v1.json",
  "title": "AdOps Advisor issue implementation manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestVersion", "issue", "state", "wave", "summary", "decisions", "scope", "requirementRefs", "dependencies", "blockers", "risks", "gates", "ownership", "acceptanceCriteria", "verification", "evidence", "rollback"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestVersion": {"type": "integer", "minimum": 1},
    "issue": {
      "type": "object",
      "required": ["number", "url", "title", "slug"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "state": {"type": "string"},
    "wave": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "out": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "requirementRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "minItems": 1},
    "gates": {"type": "array"},
    "ownership": {"type": "object", "required": ["primaryAgent", "reviewAgents", "allowedPaths", "forbiddenPaths"]},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "object", "required": ["commands", "scenarioIds"]},
    "evidence": {"type": "object", "required": ["requiredArtifacts", "retention"]},
    "rollback": {"type": "object", "required": ["strategy", "verification"]}
  }
}
