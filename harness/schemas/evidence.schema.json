{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldx.example/schemas/adops-implementation-evidence-v1.json",
  "title": "AdOps Advisor implementation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issueNumber",
    "manifestVersion",
    "baseSha",
    "commitSha",
    "state",
    "actor",
    "startedAt",
    "completedAt",
    "checks",
    "gates",
    "artifacts",
    "providerOperations",
    "rollback",
    "summary"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "issueNumber": {"type": "integer", "minimum": 1},
    "manifestVersion": {"type": "integer", "minimum": 1},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state": {"enum": ["implemented", "local_verified", "browser_verified", "staging_verified", "release_ready", "done"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agentId"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "agentId": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1}
      }
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "result", "finishedAt"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed", "not_run"]},
          "finishedAt": {"type": "string", "format": "date-time"},
          "artifact": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "decidedBy", "decidedAt", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["satisfied", "waived", "not_applicable"]},
          "decidedBy": {"type": "string", "minLength": 1},
          "decidedAt": {"type": "string", "format": "date-time"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "providerOperations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "environment", "operation", "mutation", "approved", "redactedEvidence"],
        "properties": {
          "provider": {"enum": ["google_ads", "stripe", "supabase", "openai", "cloudflare_email", "microcms", "none"]},
          "environment": {"enum": ["local", "test", "staging", "production"]},
          "operation": {"type": "string", "minLength": 1},
          "mutation": {"type": "boolean"},
          "approved": {"type": "boolean"},
          "approvalReference": {"type": "string"},
          "auditId": {"type": "string"},
          "redactedEvidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "result", "evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "result": {"enum": ["passed", "failed", "not_required", "not_run"]},
        "evidence": {"type": "string"},
        "linkedAuditId": {"type": "string"}
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "knownLimitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "description", "redacted"],
      "properties": {
        "kind": {
          "enum": [
            "test-log",
            "coverage",
            "screenshot",
            "playwright-trace",
            "video",
            "api-contract",
            "agent-eval",
            "migration-check",
            "audit-record",
            "provider-confirmation",
            "rollback-proof",
            "release-note",
            "decision-record"
          ]
        },
        "location": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "redacted": {"type": "boolean"}
      }
    }
  }
}
