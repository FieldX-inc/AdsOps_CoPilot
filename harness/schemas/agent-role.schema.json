{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldx.example/schemas/adops-agent-role-v1.json",
  "title": "AdOps Advisor implementation agent role",
  "type": "object",
  "required": ["schemaVersion", "roleId", "kind", "mission", "reportsTo", "mayDelegate", "owns", "mustNot", "inputs", "deliverables", "requiredChecks", "handoff"],
  "properties": {
    "schemaVersion": {"const": 1},
    "roleId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"enum": ["orchestrator", "subagent"]},
    "mission": {"type": "string", "minLength": 1},
    "reportsTo": {"type": ["string", "null"]},
    "mayDelegate": {"type": "boolean"},
    "owns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mustNot": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requiredChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "handoff": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
