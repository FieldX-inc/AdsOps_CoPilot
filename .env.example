# Environment
# Use one of: local, staging, production
APP_ENV=local

# Supabase project
# Local: Supabase local stack or a disposable development project.
# Staging/production: use separate Supabase projects; never share service role keys across environments.
SUPABASE_PROJECT_REF=your-local-project-ref
SUPABASE_URL=https://your-local-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@your-pooler.example.com:5432/postgres

# Browser-safe Supabase values for the future web auth client.
# These should match SUPABASE_URL / SUPABASE_ANON_KEY and must never use the service role key.
VITE_SUPABASE_URL=https://your-local-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-public-key
VITE_AUTH_REDIRECT_PATH=/auth/callback

# Supabase Auth providers: enable Email + Google in the Supabase dashboard.
# Do not reuse Google Ads OAuth credentials for app login.
# Google Cloud OAuth authorized redirect URI for app login:
# https://<supabase-project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_SITE_URL=http://localhost:5173
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:5173/auth/callback

# App
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8787
API_PUBLIC_ORIGIN=http://localhost:8787
AGENT_SERVICE_URL=http://localhost:8000
USE_AGENT_SERVICE=false
# Backward-compatible aliases. Prefer AGENT_SERVICE_URL / USE_AGENT_SERVICE for new deployments.
ADK_AGENT_URL=http://localhost:8000
USE_ADK_AGENT=false

# ngrok rehearsal example:
# WEB_ORIGIN=https://your-web.ngrok.app
# VITE_API_BASE_URL=https://your-api.ngrok.app
# VITE_AUTH_REDIRECT_PATH=/auth/callback
# GOOGLE_ADS_REDIRECT_URI=https://your-api.ngrok.app/oauth/google/callback
# SUPABASE_AUTH_SITE_URL=https://your-web.ngrok.app
# SUPABASE_AUTH_REDIRECT_URLS=https://your-web.ngrok.app/auth/callback
# Keep AGENT_SERVICE_URL private/local; do not expose the agent service directly.

# Token encryption (server-side only; 32 bytes base64 for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# Server-side OAuth app settings.
# Workspace users should not enter these values; they connect ad accounts through OAuth buttons in the UI.
# Google Ads OAuth/API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8787/oauth/google/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_STATE_STORE=db
GOOGLE_ADS_WRITE_ENABLED=false
GOOGLE_ADS_MAX_BUDGET_AMOUNT=50000
GOOGLE_ADS_API_VERSION=v24.2

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_ADS_REDIRECT_URI=http://localhost:8787/oauth/meta/callback

# Yahoo Ads API
YAHOO_ADS_CLIENT_ID=
YAHOO_ADS_CLIENT_SECRET=
YAHOO_ADS_REDIRECT_URI=http://localhost:8787/oauth/yahoo/callback

# Stripe Billing. Use a restricted API key with only the endpoints required by
# Checkout Sessions, Customers, and Billing Portal Sessions.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-05-27.dahlia
# Monthly and setup-fee amounts were approved on 2026-07-24. Create one recurring
# monthly Price and one one-time setup-fee Price per plan, then fill only the IDs.
# Standard/Premium AI limits remain separately approval-gated.
BILLING_PLANS_JSON=[{"id":"minimum","estimatedConsultations":0,"chatCreditLimit":0,"setupFee":{"stripePriceId":"","amount":50000,"currency":"jpy"},"prices":{"month":{"stripePriceId":"","amount":9800,"currency":"jpy"}}},{"id":"standard","estimatedConsultations":0,"chatCreditLimit":0,"setupFee":{"stripePriceId":"","amount":70000,"currency":"jpy"},"prices":{"month":{"stripePriceId":"","amount":49800,"currency":"jpy"}}},{"id":"premium","estimatedConsultations":0,"chatCreditLimit":0,"setupFee":{"stripePriceId":"","amount":70000,"currency":"jpy"},"prices":{"month":{"stripePriceId":"","amount":69800,"currency":"jpy"}}}]
PREMIUM_ONBOARDING_BOOKING_URL=

# AI usage and scheduled reports. Rates are USD per one million tokens and must
# be refreshed/versioned when model pricing changes.
MODEL_COST_CATALOG_JSON={"version":"openai-2026-07-15","currency":"usd","models":{"gpt-5.2":{"inputPerMillion":1.75,"cachedInputPerMillion":0.175,"outputPerMillion":14,"reasoningPerMillion":14}}}
AI_CREDIT_TOKENS=1000
REPORT_JOB_MAX_RETRIES=3
REPORT_JOB_BATCH_SIZE=50

# Cloudflare Email Service (Cloud Run API/report-job only).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
REPORT_EMAIL_DOMAIN=
REPORT_EMAIL_FROM_LOCAL_PART=reports
REPORT_EMAIL_FROM_NAME=ちょこっとインハウス
NOTIFICATION_SIGNING_SECRET=

# Agent runtime orchestration
# Use "openai" for OpenAI Agents SDK, "gemini" for fallback ADK/Gemini runtime, or "mock" for local smoke.
ADOPS_AGENT_RUNTIME=openai

# OpenAI Agents SDK
OPENAI_API_KEY=
OPENAI_AGENTS_MODEL=gpt-5.2
OPENAI_AGENTS_TIMEOUT_SECONDS=45
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
OPENAI_AGENT_STAGING_E2E_PASSED_AT=

# Fallback ADK / Gemini
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_RUNTIME=auto
GEMINI_TIMEOUT_SECONDS=30
GEMINI_REST_SHORT_MAX_OUTPUT_TOKENS=768
GEMINI_REST_LIGHT_MAX_OUTPUT_TOKENS=768
GEMINI_REST_MAX_OUTPUT_TOKENS=4096
AGENT_SERVICE_TIMEOUT_MS=35000
ADK_AGENT_TIMEOUT_MS=35000
CHAT_STATUS_EVENT_DELAY_MS=80

# Production go/no-go evidence.
# Set these only after the corresponding staging E2E run actually passed.
GOOGLE_ADS_STAGING_E2E_PASSED_AT=
STRIPE_STAGING_E2E_PASSED_AT=
SUPABASE_STAGING_E2E_PASSED_AT=
REPORT_EMAIL_STAGING_E2E_PASSED_AT=
DEPLOYMENT_RUNBOOK_ACK=false
PRODUCTION_SMOKE_PASSED_AT=
RELEASE_EVIDENCE_COLLECTED_AT=

# microCMS Help content. Create a list API with endpoint `help`.
# Cloud Run API only; use a GET-only key and never expose it to Vite.
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
MICROCMS_TIMEOUT_MS=4000

# Optional search tool settings for agent experiments.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_TIMEOUT_SECONDS=8
