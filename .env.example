# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth providers: enable Email + Google in the Supabase dashboard.
# Do not reuse Google Ads OAuth credentials for app login.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=

# App
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787
ADK_AGENT_URL=http://localhost:8000

# Token encryption (server-side only; 32 bytes base64 for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# Server-side OAuth app settings.
# Workspace users should not enter these values; they connect ad accounts through OAuth buttons in the UI.
# Google Ads OAuth/API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=

# Yahoo Ads API
YAHOO_ADS_CLIENT_ID=
YAHOO_ADS_CLIENT_SECRET=

# ADK / Gemini
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_RUNTIME=auto
