# Environment
# Use one of: local, staging, production
APP_ENV=local

# Supabase project
# Local: Supabase local stack or a disposable development project.
# Staging/production: use separate Supabase projects; never share service role keys across environments.
SUPABASE_PROJECT_REF=rneudxlrtsvtyabtynbw
SUPABASE_URL=https://rneudxlrtsvtyabtynbw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJuZXVkeGxydHN2dHlhYnR5bmJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMjIyMDAsImV4cCI6MjA5Mjc5ODIwMH0.qJVBsrdu_nC83d4MCJT0l3gPdSAwxjQ9n8NSWu0e8Pk
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.rneudxlrtsvtyabtynbw:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Browser-safe Supabase values for the future web auth client.
# These should match SUPABASE_URL / SUPABASE_ANON_KEY and must never use the service role key.
VITE_SUPABASE_URL=https://rneudxlrtsvtyabtynbw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJuZXVkeGxydHN2dHlhYnR5bmJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMjIyMDAsImV4cCI6MjA5Mjc5ODIwMH0.qJVBsrdu_nC83d4MCJT0l3gPdSAwxjQ9n8NSWu0e8Pk

# Supabase Auth providers: enable Email + Google in the Supabase dashboard.
# Do not reuse Google Ads OAuth credentials for app login.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_SITE_URL=http://localhost:5173
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:5173/auth/callback

# App
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787
ADK_AGENT_URL=http://localhost:8000
USE_ADK_AGENT=false

# Token encryption (server-side only; 32 bytes base64 for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# Server-side OAuth app settings.
# Workspace users should not enter these values; they connect ad accounts through OAuth buttons in the UI.
# Google Ads OAuth/API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8787/oauth/google/callback

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_ADS_REDIRECT_URI=http://localhost:8787/oauth/meta/callback

# Yahoo Ads API
YAHOO_ADS_CLIENT_ID=
YAHOO_ADS_CLIENT_SECRET=
YAHOO_ADS_REDIRECT_URI=http://localhost:8787/oauth/yahoo/callback

# ADK / Gemini
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_RUNTIME=auto

# Optional search tool settings for ADK experiments.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_TIMEOUT_SECONDS=8
