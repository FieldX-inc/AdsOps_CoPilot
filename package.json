{
  "name": "adops-advisor",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,agent -c cyan,magenta,green \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:agent\"",
    "dev:web": "npm --workspace @adops/web run dev",
    "dev:api": "npm --workspace @adops/api run dev",
    "dev:agent": "cd services/adk-agent && python3.11 -m ad_ops_advisor.http_server",
    "build": "npm --workspace @adops/web run build && npm --workspace @adops/api run build",
    "typecheck": "npm --workspace @adops/web run typecheck && npm --workspace @adops/api run typecheck",
    "check:env": "node scripts/check-env.mjs",
    "check:env-contracts": "node scripts/check-env-contracts.mjs",
    "check:demo-fixture": "node scripts/check-demo-fixture-contracts.mjs",
    "check:harness": "node scripts/check-implementation-harness-contracts.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:docker": "node scripts/check-dockerfiles.mjs",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "check:deploy-preflight": "node scripts/check-deploy-preflight-contracts.mjs",
    "check:operator-prereq-note": "node scripts/check-operator-prereq-note-contracts.mjs",
    "check:deploy-next": "node scripts/check-deploy-next-actions-contracts.mjs",
    "check:deploy-commands": "node scripts/check-deploy-command-plan-contracts.mjs",
    "check:production-candidate-audit": "node scripts/check-production-candidate-audit-contracts.mjs",
    "check:completion-audit": "node scripts/check-completion-audit-contracts.mjs",
    "check:completion-evidence-note": "node scripts/check-completion-evidence-note-contracts.mjs",
    "check:goal": "node scripts/check-production-goal.mjs",
    "check:handoff": "node scripts/check-operator-handoff.mjs",
    "check:release-evidence": "node scripts/check-release-evidence-template.mjs",
    "check:release-evidence-collector": "node scripts/check-release-evidence-collector-contracts.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:smoke": "node scripts/check-smoke-deploy-contracts.mjs",
    "check:staging-e2e": "node scripts/check-staging-e2e-contracts.mjs",
    "check:web-contracts": "node scripts/check-web-contracts.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "deploy:prereq-note": "node scripts/operator-prereq-note.mjs",
    "deploy:next": "node scripts/deploy-next-actions.mjs",
    "deploy:commands": "node scripts/deploy-command-plan.mjs",
    "audit:production-candidate": "node scripts/production-candidate-audit.mjs",
    "audit:completion": "node scripts/completion-audit.mjs",
    "audit:completion-note": "node scripts/completion-evidence-note.mjs",
    "demo:reset": "node scripts/reset-demo-fixture.mjs",
    "harness:validate": "node scripts/implementation-harness.mjs validate",
    "harness:list": "node scripts/implementation-harness.mjs list",
    "harness:plan": "node scripts/implementation-harness.mjs plan",
    "collect:release-evidence": "node scripts/collect-release-evidence.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "e2e:browser": "playwright test",
    "e2e:browser:headed": "playwright test --headed",
    "e2e:staging": "node scripts/staging-e2e.mjs",
    "e2e:supabase": "node scripts/supabase-e2e.mjs",
    "e2e:stripe-webhook": "node scripts/stripe-webhook-e2e.mjs",
    "test:api": "npm --workspace @adops/api test",
    "test:agent": "python3.11 -m pytest services/adk-agent/tests",
    "test": "npm run test:api && npm run test:agent",
    "verify": "npm run check:env && npm run check:env-contracts && npm run check:demo-fixture && npm run check:harness && npm run check:migrations && npm run check:docker && npm run check:deploy && npm run check:deploy-preflight && npm run check:operator-prereq-note && npm run check:deploy-next && npm run check:deploy-commands && npm run check:production-candidate-audit && npm run check:completion-audit && npm run check:completion-evidence-note && npm run check:goal && npm run check:handoff && npm run check:release-evidence && npm run check:release-evidence-collector && npm run check:scripts && npm run check:smoke && npm run check:staging-e2e && npm run check:web-contracts && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2"
  }
}
